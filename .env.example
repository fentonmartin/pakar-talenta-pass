# Environment configuration for Pakar Talenta Pass.
# See README.md for the quick start.

NODE_ENV=development

# Data mode: false uses the real PostgreSQL database; true serves an in-memory demo dataset (no DB).
DEMO_MODE=false

# Database — required only when DEMO_MODE=false
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/pakar_talenta
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pakar_talenta

# Redis (worker queue)
REDIS_URL=redis://localhost:6379

# Auth — required
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# bcrypt hash for the admin password (dev default below matches "admin123"; regenerate with `node scripts/hash-password.mjs <pw>`)
# NOTE: dollar signs must be escaped (\$) so dotenv-expand doesn't strip them
ADMIN_PASSWORD_HASH=\$2b\$12\$ivoHYQImm7WtMj0x8yWd4OJRy4qmsxd/3bLrJDAZZQreBA7Po.nim
TOTP_SECRET=JBSWY3DPEHPK3PXP
TOTP_ISSUER=Pakar Talenta Pass

# Mail — required
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pakar Talenta Pass <noreply@pakartalenta.co.id>

# Optional
RESEND_API_KEY=

# URLs
BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
PASS_DOMAIN=pass.pakartalenta.co.id
APP_NAME=Pakar Talenta Pass
